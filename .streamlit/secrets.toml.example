# Copy to .streamlit/secrets.toml for LOCAL use, or paste into Streamlit Community Cloud -> Advanced settings -> Secrets.
# Placeholders only. NEVER commit the real file (it is in .gitignore).
DWN_ENV = "prod"
DATABASE_URL = "postgresql://postgres.YOURPROJECTREF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DWN_SEED_DEMO = "1"                 # synthetic demo accounts/clients; remove after the first start if you want an empty system
DWN_DEMO_PASSWORD = "choose-a-long-unique-demo-password"
# Turn the AI on (free): create a key at console.groq.com -> API Keys, then uncomment the next line. That is all:
# the app detects the key and uses Groq for the copilot, drafts, event interpretation and chat-reply drafts.
# GROQ_API_KEY = ""
# DWN_LLM_PROVIDER = "groq"        # optional: only needed to force a provider (template | groq | gemini)
# GROQ_MODEL = "openai/gpt-oss-20b"
# GEMINI_API_KEY = ""
# Fixes 'FetchError: HTTP 403' from BLS (it blocks requests that carry no contact): put YOUR OWN contact string here.
# DWN_CONTACT = "you@example.com"
# ALPHAVANTAGE_API_KEY = ""
# DWN_ASYNC_JOBS = "1"            # 1 (default) = Run now works in the background; 0 = run inside the click

