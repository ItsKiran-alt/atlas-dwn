# Placeholder values only. Never commit real secrets.
DWN_ENV=dev
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME   (leave unset locally to use SQLite in ./data)
DWN_DEMO_PASSWORD=atlas-demo
# Optional contact string added to the User-Agent of outbound data requests (the SEC asks for one):
# DWN_CONTACT=you@example.com
# Optional fallback price provider (free key from alphavantage.co; 25 requests/day):
# ALPHAVANTAGE_API_KEY=

# LLM (optional). Default is 'template' = deterministic rules, no AI, no network.
# DWN_LLM_PROVIDER=groq            # template | groq | gemini
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GEMINI_API_KEY=
# GEMINI_MODEL=                    # confirm the current model id in Google AI Studio
# DWN_LLM_DAILY_BUDGET=100
